{
	"name": "brodynelly-ui",
	"version": "0.1.0",
	"private": true,
	"description": "Editable Svelte 5 components, copied into your project with the Brodynelly UI CLI.",
	"type": "module",
	"license": "MIT",
	"author": "Brodynelly",
	"repository": {
		"type": "git",
		"url": "https://github.com/brodynelly/brodynelly-ui.git"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"bin": {
		"brodynelly-ui": "bin/brodynelly-ui.mjs"
	},
	"files": [
		"bin",
		"cli",
		"registry",
		"LICENSE",
		"NOTICE.md"
	],
	"scripts": {
		"dev": "vite dev",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"site:build": "vite build",
		"registry:build": "node scripts/build-registry.mjs",
		"registry:check": "node scripts/build-registry.mjs --check",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:registry": "node --test tests/registry/*.test.mjs",
		"test:installer": "node --test tests/cli/*.test.mjs",
		"test:distribution": "node --test tests/distribution/*.test.mjs",
		"test:opencode": "node --test .opencode/checks/*.test.mjs",
		"test:verification": "node --test tests/verification/*.test.mjs",
		"test:git-package": "node scripts/verify-git-package.mjs",
		"lint": "prettier --check . && eslint .",
		"verify": "npm run sync && npm run registry:check && npm run test:registry && npm run test:installer && npm test && npm run test:opencode && npm run test:verification && npm run test:distribution && npm run lint && npm run site:build && npm audit && npm audit --omit=dev"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@vitest/browser-playwright": "^4.1.11",
		"acorn": "^8.15.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"playwright": "^1.55.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.55.7",
		"typescript": "^5.3.2",
		"vite": "^7.3.5",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	}
}
