      "content": "<script>\n\t/**\n\t * A native search input with an accessible, keyboard-operable clear button.\n\t * `class` and `style` apply to the wrapper; other attributes target the input.\n\t * Callbacks receive native events after the binding updates. Clearing emits\n\t * bubbling `input` and `change` events, then leaves focus in the input.\n\t * @typedef {Omit<import('svelte/elements').HTMLInputAttributes, 'type' | 'role' | 'value'> & {\n\t *   value?: string;\n\t *   label?: string;\n\t * }} Props\n\t */\n\t/** @type {Props} */\n\tlet {\n\t\tvalue = $bindable(''),\n\t\tlabel = 'Search',\n\t\tplaceholder = 'Search',\n\t\tdisabled = false,\n\t\treadonly = false,\n\t\toninput,\n\t\tonchange,\n\t\tid,\n\t\tclass: className,\n\t\tstyle,\n\t\t...rest\n\t} = $props();\n\n\tconst generatedId = $props.id();\n\tlet inputId = $derived(id ?? generatedId);\n\t/** @type {HTMLInputElement | undefined} */\n\tlet input = $state();\n\n\t/** @param {Event & { currentTarget: HTMLInputElement }} event */\n\tfunction handleInput(event) {\n\t\tvalue = event.currentTarget.value;\n\t\toninput?.(event);\n\t}\n\n\t/** @param {Event & { currentTarget: HTMLInputElement }} event */\n\tfunction handleChange(event) {\n\t\tvalue = event.currentTarget.value;\n\t\tonchange?.(event);\n\t}\n\n\tfunction clear() {\n\t\tif (disabled || readonly || !input || value === '') return;\n\t\tvalue = '';\n\t\tinput.value = '';\n\t\tinput.focus();\n\t\tinput.dispatchEvent(new Event('input', { bubbles: true }));\n\t\tinput.dispatchEvent(new Event('change', { bubbles: true }));\n\t}\n</script>\n\n<div class={['apple-search-field', className]} {style} data-disabled={disabled || undefined}>\n\t<label class=\"search-label\" for={inputId}>{label}</label>\n\t<div class=\"search-control\">\n\t\t<svg\n\t\t\tclass=\"search-icon\"\n\t\t\twidth=\"20\"\n\t\t\theight=\"20\"\n\t\t\tviewBox=\"0 0 20 20\"\n\t\t\tfill=\"none\"\n\t\t\taria-hidden=\"true\"\n\t\t>\n\t\t\t<circle cx=\"8.5\" cy=\"8.5\" r=\"5.5\" stroke=\"currentColor\" stroke-width=\"1.6\" />\n\t\t\t<path d=\"m12.5 12.5 4 4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" />\n\t\t</svg>\n\t\t<input\n\t\t\t{...rest}\n\t\t\tid={inputId}\n\t\t\ttype=\"search\"\n\t\t\t{placeholder}\n\t\t\t{disabled}\n\t\t\t{readonly}\n\t\t\tbind:this={input}\n\t\t\tbind:value\n\t\t\toninput={handleInput}\n\t\t\tonchange={handleChange}\n\t\t/>\n\t\t{#if value !== ''}\n\t\t\t<button\n\t\t\t\ttype=\"button\"\n\t\t\t\taria-label={`Clear ${label}`}\n\t\t\t\tdisabled={disabled || readonly}\n\t\t\t\tonclick={clear}\n\t\t\t>\n\t\t\t\t<svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n\t\t\t\t\t<circle cx=\"10\" cy=\"10\" r=\"8\" fill=\"currentColor\" />\n\t\t\t\t\t<path\n\t\t\t\t\t\td=\"m7.5 7.5 5 5m0-5-5 5\"\n\t\t\t\t\t\tstroke=\"var(--apple-control-thumb, #fff)\"\n\t\t\t\t\t\tstroke-width=\"1.5\"\n\t\t\t\t\t\tstroke-linecap=\"round\"\n\t\t\t\t\t/>\n\t\t\t\t</svg>\n\t\t\t</button>\n\t\t{/if}\n\t</div>\n</div>\n\n<style>\n\t.apple-search-field {\n\t\t--search-fill: var(--apple-control-fill, var(--fills-tertiary, #7676801f));\n\t\t--search-text: var(--apple-label, var(--labels-primary, #1c1c1e));\n\t\t--search-secondary: var(--apple-secondary-label, #59595f);\n\t\tbox-sizing: border-box;\n\t\tcolor: var(--search-text);\n\t\tfont-family: var(\n\t\t\t--apple-font-family,\n\t\t\tvar(--sans-serif-font-family, ui-sans-serif, system-ui, -apple-system, sans-serif)\n\t\t);\n\t\tfont-size: 17px;\n\t\tfont-weight: 400;\n\t\tline-height: 22px;\n\t\tmin-width: 0;\n\t\twidth: 100%;\n\t}\n\n\t.search-label {\n\t\tclip-path: inset(50%);\n\t\theight: 1px;\n\t\toverflow: hidden;\n\t\tposition: absolute;\n\t\twhite-space: nowrap;\n\t\twidth: 1px;\n\t}\n\n\t.search-control {\n\t\talign-items: center;\n\t\tbackground: var(--search-fill);\n\t\tborder: 1px solid transparent;\n\t\tborder-radius: var(--apple-control-radius, 12px);\n\t\tbox-sizing: border-box;\n\t\tdisplay: flex;\n\t\tgap: 8px;\n\t\tmin-height: 44px;\n\t\tpadding-inline-start: 12px;\n\t}\n\n\t.search-control:focus-within {\n\t\toutline: 2px solid var(--apple-accent, var(--colors-accent, #0088ff));\n\t\toutline-offset: 2px;\n\t}\n\n\t.search-icon {\n\t\tcolor: var(--search-secondary);\n\t\tflex-shrink: 0;\n\t\tpointer-events: none;\n\t}\n\n\tinput {\n\t\t-webkit-appearance: none;\n\t\tappearance: none;\n\t\tbackground: transparent;\n\t\tborder: 0;\n\t\tborder-radius: 0;\n\t\tbox-sizing: border-box;\n\t\tcolor: inherit;\n\t\tflex: 1;\n\t\tfont: inherit;\n\t\tmargin: 0;\n\t\tmin-height: 44px;\n\t\tmin-width: 0;\n\t\tpadding: 10px 12px 10px 0;\n\t\tuser-select: text;\n\t\twidth: 100%;\n\t}\n\n\tinput:focus {\n\t\toutline: none;\n\t}\n\n\tinput::placeholder {\n\t\tcolor: var(--search-secondary);\n\t\topacity: 1;\n\t}\n\n\tinput::-webkit-search-cancel-button,\n\tinput::-webkit-search-decoration {\n\t\t-webkit-appearance: none;\n\t\tappearance: none;\n\t}\n\n\tbutton {\n\t\talign-items: center;\n\t\tappearance: none;\n\t\tbackground: transparent;\n\t\tborder: 0;\n\t\tborder-radius: 10px;\n\t\tbox-sizing: border-box;\n\t\tcolor: var(--search-secondary);\n\t\tcursor: pointer;\n\t\tdisplay: inline-flex;\n\t\tflex: 0 0 44px;\n\t\tjustify-content: center;\n\t\tmargin: 0;\n\t\tmin-height: 44px;\n\t\tmin-width: 44px;\n\t\tpadding: 0;\n\t\ttouch-action: manipulation;\n\t}\n\n\tbutton:active:not(:disabled) {\n\t\tbackground: var(--apple-control-press, #78788029);\n\t}\n\n\tbutton:focus-visible {\n\t\toutline: 2px solid var(--apple-accent, var(--colors-accent, #0088ff));\n\t\toutline-offset: -3px;\n\t}\n\n\tinput:disabled,\n\tbutton:disabled {\n\t\tcursor: not-allowed;\n\t}\n\n\t.apple-search-field[data-disabled] {\n\t\topacity: 0.5;\n\t}\n\n\t@media (prefers-color-scheme: dark) {\n\t\t.apple-search-field {\n\t\t\t--search-fill: var(--apple-control-fill, var(--fills-tertiary, #7676803d));\n\t\t\t--search-text: var(--apple-label, var(--labels-primary, #f5f5f7));\n\t\t\t--search-secondary: var(--apple-secondary-label, #aeaeb2);\n\t\t}\n\t}\n\n\t@media (prefers-reduced-motion: reduce) {\n\t\tbutton,\n\t\t.search-control {\n\t\t\ttransition: none;\n\t\t}\n\t}\n\n\t@media (prefers-reduced-transparency: reduce) {\n\t\t.apple-search-field {\n\t\t\t--search-fill: var(--apple-control-solid-fill, #efeff0);\n\t\t}\n\n\t\t@media (prefers-color-scheme: dark) {\n\t\t\t.apple-search-field {\n\t\t\t\t--search-fill: var(--apple-control-solid-fill, #2c2c2e);\n\t\t\t}\n\t\t}\n\t}\n\n\t@media (prefers-contrast: more) {\n\t\t.search-control {\n\t\t\tborder-color: currentColor;\n\t\t}\n\n\t\t.apple-search-field[data-disabled] {\n\t\t\topacity: 1;\n\t\t}\n\t}\n\n\t@media (forced-colors: active) {\n\t\t.search-control {\n\t\t\tbackground: Field;\n\t\t\tborder-color: FieldText;\n\t\t\tcolor: FieldText;\n\t\t}\n\n\t\t.search-control:focus-within,\n\t\tbutton:focus-visible {\n\t\t\toutline-color: Highlight;\n\t\t}\n\n\t\t.apple-search-field[data-disabled] {\n\t\t\tcolor: GrayText;\n\t\t\topacity: 1;\n\t\t}\n\t}\n</style>\n"
    }
  ]
