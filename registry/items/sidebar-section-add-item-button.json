      "content": "<script>\n\texport let symbol = 'add';\n\texport let title = 'Add Item';\n\n\texport let id = undefined;\n\texport let onPress = undefined;\n\texport let style = undefined;\n\n\tlet inputElement = undefined;\n\n\tfunction handlePress() {\n\t\tif (onPress) {\n\t\t\tonPress();\n\t\t}\n\t\tinputElement.blur();\n\t}\n</script>\n\n<label {id} {style}>\n\t<button aria-label=\"Add item\" bind:this={inputElement} class=\"symbol\" on:click={handlePress}\n\t\t>{symbol}</button\n\t>\n\t<p>{title}</p>\n</label>\n\n<style>\n\tlabel {\n\t\talign-items: center;\n\t\tborder-radius: 11px;\n\t\tdisplay: flex;\n\t\tgap: 8px;\n\t\theight: 44px;\n\t\tmargin: 0px 16px;\n\t\tpadding: 0px 8px;\n\t\twhite-space: nowrap;\n\t}\n\n\t.symbol {\n\t\talign-items: center;\n\t\tbackground: var(--fills-tertiary);\n\t\tborder-radius: 3px;\n\t\tcolor: var(--colors-accent);\n\t\tdisplay: flex;\n\t\tflex-shrink: 0;\n\t\tfont-size: calc(17px * var(--medium-symbol-font-size-multiplier));\n\t\tfont-weight: calc(590 / var(--medium-symbol-font-size-multiplier));\n\t\tline-height: 22px;\n\t\theight: 28px;\n\t\tjustify-content: center;\n\t\twidth: 28px;\n\t}\n\n\tp {\n\t\tfont-size: 17px;\n\t\tfont-weight: 400;\n\t\tline-height: 19px;\n\t}\n\n\tbutton:active {\n\t\tbackground: unset !important;\n\t\topacity: var(--symbol-press-opacity) !important;\n\t\toutline: unset !important;\n\t}\n\n\tbutton:focus {\n\t\toutline: 2px solid var(--colors-accent);\n\t\toutline-offset: 4px;\n\t}\n\n\tlabel:hover {\n\t\topacity: var(--hover-opacity);\n\t}\n</style>\n"
