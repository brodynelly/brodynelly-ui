      "sha256": "2f8269b05c6c8b1da9a7ea00e9ca0f32edb92f28f6ed7acc7f6e663f9d8d445f",
      "content": "<script>\n\t/**\n\t * @typedef {Object} Props\n\t * @property {string} [label=''] Accessible label and typeahead text; also the default visible content.\n\t * @property {boolean} [disabled=false] Prevents activation and is skipped by keyboard navigation.\n\t * @property {boolean} [destructive=false] Marks a destructive action visually.\n\t * @property {boolean} [checked] Bindable state. Supplying a boolean gives the menuitemcheckbox role.\n\t * @property {(event: MouseEvent) => void} [onclick] Called before activation; preventDefault() prevents toggling and keeps the menu open.\n\t * @property {import('svelte').Snippet} [children] Noninteractive content in place of the label.\n\t * @property {string} [id]\n\t * @property {string} [class]\n\t * @property {string} [style]\n\t */\n\n\t/** @type {Props} */\n\tlet {\n\t\tlabel = '',\n\t\tdisabled = false,\n\t\tdestructive = false,\n\t\tchecked = $bindable(undefined),\n\t\tonclick,\n\t\tchildren,\n\t\tid,\n\t\tclass: className = '',\n\t\tstyle\n\t} = $props();\n\n\t/** @param {MouseEvent} event */\n\tfunction activate(event) {\n\t\tif (disabled) {\n\t\t\tevent.preventDefault();\n\t\t\treturn;\n\t\t}\n\t\tonclick?.(event);\n\t\tif (!event.defaultPrevented && checked !== undefined) checked = !checked;\n\t}\n</script>\n\n<button\n\tclass={`menu-item ${className}`}\n\tclass:destructive\n\t{id}\n\t{style}\n\ttype=\"button\"\n\trole={checked === undefined ? 'menuitem' : 'menuitemcheckbox'}\n\taria-label={label || undefined}\n\taria-checked={checked}\n\taria-disabled={disabled || undefined}\n\t{disabled}\n\ttabindex=\"-1\"\n\tdata-menu-label={label || undefined}\n\tonclick={activate}\n>\n\t{#if checked !== undefined}\n\t\t<span class=\"menu-check\" aria-hidden=\"true\">\n\t\t\t{#if checked}\n\t\t\t\t<svg viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" fill=\"none\">\n\t\t\t\t\t<path\n\t\t\t\t\t\td=\"m4.5 10 3.5 3.5 7.5-8\"\n\t\t\t\t\t\tstroke=\"currentColor\"\n\t\t\t\t\t\tstroke-width=\"1.8\"\n\t\t\t\t\t\tstroke-linecap=\"round\"\n\t\t\t\t\t\tstroke-linejoin=\"round\"\n\t\t\t\t\t/>\n\t\t\t\t</svg>\n\t\t\t{/if}\n\t\t</span>\n\t{/if}\n\t<span class=\"menu-item-content\">\n\t\t{#if children}\n\t\t\t{@render children()}\n\t\t{:else}\n\t\t\t{label}\n\t\t{/if}\n\t</span>\n</button>\n\n<style>\n\t.menu-item {\n\t\talign-items: center;\n\t\tappearance: none;\n\t\tbackground: transparent;\n\t\tborder: 0;\n\t\tborder-radius: 18px;\n\t\tbox-sizing: border-box;\n\t\tcolor: inherit;\n\t\tcursor: pointer;\n\t\tdisplay: flex;\n\t\tflex: 0 0 auto;\n\t\tfont-family: var(--sans-serif-font-family, ui-sans-serif, system-ui, sans-serif);\n\t\tfont-size: 15px;\n\t\tfont-weight: 500;\n\t\tgap: 8px;\n\t\tletter-spacing: 0.01em;\n\t\tline-height: 20px;\n\t\tmargin: 0;\n\t\tmin-height: 44px;\n\t\tpadding: 10px 12px;\n\t\ttext-align: start;\n\t\ttouch-action: manipulation;\n\t\twidth: 100%;\n\t\t-webkit-tap-highlight-color: transparent;\n\t}\n\n\t.menu-item-content {\n\t\tflex: 1;\n\t\tmin-width: 0;\n\t\toverflow-wrap: anywhere;\n\t}\n\n\t.menu-check {\n\t\talign-items: center;\n\t\tdisplay: inline-flex;\n\t\tflex: 0 0 20px;\n\t\tjustify-content: center;\n\t}\n\n\t.menu-item.destructive {\n\t\tcolor: var(--menu-destructive, #c52228);\n\t}\n\n\t.menu-item:focus-visible {\n\t\tbackground: var(--fills-tertiary, rgb(118 118 128 / 12%));\n\t\toutline: 2px solid var(--apple-focus-ring, var(--colors-accent, #007aff));\n\t\toutline-offset: -2px;\n\t}\n\n\t@media (hover: hover) {\n\t\t.menu-item:hover:not(:disabled) {\n\t\t\tbackground: var(--fills-tertiary, rgb(118 118 128 / 12%));\n\t\t}\n\t}\n\n\t.menu-item:active:not(:disabled) {\n\t\tbackground: var(--fills-primary, rgb(120 120 120 / 20%));\n\t}\n\n\t.menu-item:disabled {\n\t\tcolor: var(--menu-disabled, #737378);\n\t\tcursor: default;\n\t}\n\n\t@media (prefers-color-scheme: dark) {\n\t\t.menu-item.destructive {\n\t\t\tcolor: var(--menu-destructive, #ff696c);\n\t\t}\n\t\t.menu-item:disabled {\n\t\t\tcolor: var(--menu-disabled, #969699);\n\t\t}\n\t}\n\n\t@media (prefers-contrast: more) {\n\t\t.menu-item:focus-visible {\n\t\t\toutline-width: 3px;\n\t\t}\n\t}\n\n\t@media (forced-colors: active) {\n\t\t.menu-item.destructive {\n\t\t\tcolor: ButtonText;\n\t\t}\n\t\t.menu-item:focus-visible,\n\t\t.menu-item:active:not(:disabled) {\n\t\t\tbackground: Highlight;\n\t\t\tcolor: HighlightText;\n\t\t\toutline-color: Highlight;\n\t\t}\n\t\t.menu-item:disabled {\n\t\t\tcolor: GrayText;\n\t\t}\n\t}\n</style>\n"
    }
  ]
