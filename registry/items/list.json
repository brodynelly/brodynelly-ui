      "content": "<script>\n\texport let showHeader = false;\n\texport let headerType = 'default';\n\t/* export let headerType = \"plain\"; */\n\t/* export let headerType = \"prominent\"; */\n\texport let header = 'Header text';\n\texport let disclosure = 'arrow_forward_ios';\n\texport let showFooter = false;\n\texport let footer = 'Footer text';\n\n\texport let id = undefined;\n\texport let onPress = undefined;\n\texport let style = undefined;\n\n\tlet marginTop = 'unset';\n\tif (showHeader) {\n\t\tmarginTop = '18px';\n\t} else {\n\t\tmarginTop = '24px';\n\t}\n\n\tlet marginBottom = 'unset';\n\tif (showFooter) {\n\t\tmarginBottom = '18px';\n\t} else {\n\t\tmarginBottom = '24px';\n\t}\n</script>\n\n<div class=\"collection\" {id} style=\"{style}; margin: {marginTop} 0px {marginBottom}\">\n\t{#if showHeader}\n\t\t{#if headerType === 'default'}\n\t\t\t<p class=\"header\">{header}</p>\n\t\t{:else if headerType === 'plain'}\n\t\t\t<p class=\"subheadline-emphasized\">{header}</p>\n\t\t{:else}\n\t\t\t<label class=\"title3-emphasized\">\n\t\t\t\t{header}\n\t\t\t\t<button class=\"symbol\" on:click={onPress}>{disclosure}</button>\n\t\t\t</label>\n\t\t{/if}\n\t{/if}\n\t<div class=\"list\">\n\t\t<slot />\n\t</div>\n\t{#if showFooter}\n\t\t<p class=\"footer\">{footer}</p>\n\t{/if}\n</div>\n\n<style>\n\t.header {\n\t\tcolor: var(--labels-secondary);\n\t\tfont-size: 13px;\n\t\tfont-weight: 400;\n\t\tline-height: 16px;\n\t\tmargin: 0px 16px 7px;\n\t\ttext-transform: uppercase;\n\t}\n\n\t.subheadline-emphasized {\n\t\tcolor: var(--labels-secondary);\n\t\tmargin: 0px 16px 7px;\n\t}\n\n\t.title3-emphasized {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\tmargin: 0px 19px 5px;\n\t}\n\n\t.symbol {\n\t\tcolor: var(--colors-accent);\n\t\tfont-feature-settings: 'ss15' on;\n\t\tfont-size: calc(17px * var(--small-symbol-font-size-multiplier));\n\t\tfont-weight: 590;\n\t\tline-height: 25px;\n\t}\n\n\t.list {\n\t\tborder-radius: 10px;\n\t\toverflow: hidden;\n\t}\n\n\t.footer {\n